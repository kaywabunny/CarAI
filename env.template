# MySQL Database Configuration
# Copy this file to .env and update with your actual values
# docker-compose will automatically read .env file

# MySQL Host (will be 'db' in docker-compose, 'localhost' for local development)
MYSQL_HOST=db

# MySQL Port
MYSQL_PORT=3306

# Database Name
MYSQL_DB=carpricing

# MySQL User
MYSQL_USER=car_user

# MySQL Password
MYSQL_PASSWORD=StrongPassword123

# MySQL Root Password (for database initialization)
MYSQL_ROOT_PASSWORD=TestPassword123!

